{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebaserc.example",
      ".git",
      ".git/**",
      ".gitignore",
      ".firebase/**",
      "logs/**",
      "docs/**",
      "assets/source/**",
      "*.bak",
      "**/*.bak",
      "*.zip",
      "**/*.zip",
      "firebase-debug.log",
      "firebase-debug.log.*",
      "*.log",
      "*.err",
      "firestore.rules",
      "firestore.rules.example",
      "README.md",
      "server*.log",
      "server*.err"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|svg|png|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
